# --- Сайт --------------------------------------------------------------------
BASE_URL=https://zvet.ru

# --- Существующий тестовый аккаунт (обязательно для позитивных тестов и E2E) --
# В репозитории эти значения хранить нельзя: заполните локальный .env
TEST_EMAIL=
TEST_PASSWORD=
TEST_PHONE=

# --- Ручные шаги: капча и SMS -------------------------------------------------
# Разрешить ввод капчи и SMS-кода в видимом браузере для теста manual
MANUAL_TESTS=0
MANUAL_TIMEOUT=180

# --- Браузер ------------------------------------------------------------------
HEADLESS=1
BROWSER=chromium
BROWSER_SLOW_MO=0
DEFAULT_TIMEOUT=15000
NAVIGATION_TIMEOUT=45000
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900

# --- Логирование ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/test.log

# --- Тестовые данные -----------------------------------------------------------
SEARCH_QUERY=диван
CUSTOMER_NAME=Тестовый Покупатель
CUSTOMER_PHONE=
CUSTOMER_CITY=Москва
CUSTOMER_ADDRESS=ул. Тверская, д. 1
CUSTOMER_EMAIL=

# --- Артефакты -----------------------------------------------------------------
REPORTS_DIR=reports
